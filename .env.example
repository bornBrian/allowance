# Copy this file to .env and fill in your own keys. Never commit .env.

# PayPal developer dashboard -> Apps & Credentials -> Sandbox -> your app.
# In the app's settings, turn on "Save payment methods".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Channel3 dashboard -> API keys
CHANNEL3_API_KEY=

# Anthropic console -> API keys
ANTHROPIC_API_KEY=

# Cloudflare dashboard -> Turnstile -> add a widget (managed mode).
# Leave both empty to turn the human check off, e.g. when running locally.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The public address of the app, used for PayPal's return links. Optional locally.
APP_URL=

# Cost caps. Claude spending per UTC day and in total (US dollars), and Channel3 calls per month.
# The total cap protects anything else that shares the same Anthropic credit.
DAILY_AI_BUDGET_USD=0.25
AI_TOTAL_BUDGET_USD=1
CHANNEL3_MONTHLY_LIMIT=900

# Optional: a different Claude model. Defaults to claude-haiku-5-5.
# CLAUDE_MODEL=

# Where the SQLite file lives. Defaults to data/allowance.db.
# DATABASE_PATH=
