# Copy this file to .env and fill in your own keys. Never commit .env.

# PayPal developer dashboard -> Apps & Credentials -> Sandbox -> your app.
# In the app's settings, turn on "Save payment methods".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Channel3 dashboard -> API keys
CHANNEL3_API_KEY=

# Anthropic console -> API keys
ANTHROPIC_API_KEY=

# Cloudflare dashboard -> Turnstile -> add a widget (managed mode).
# Leave both empty to turn the human check off, e.g. when running locally.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Web Push keys, so approval requests reach the payer's phone as notifications.
# Generate once with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is the app's public address (or a mailto: address).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional: a PayPal sandbox buyer (developer dashboard -> Testing Tools -> Sandbox Accounts),
# shown on the setup screen so judges and testers can link PayPal. Sandbox only, never a real account.
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# The public address of the app, used for PayPal's return links. Optional locally.
APP_URL=

# Cost caps. Claude spending per UTC day and in total (US dollars), and Channel3 calls per month.
# The total cap protects anything else that shares the same Anthropic credit.
DAILY_AI_BUDGET_USD=0.25
AI_TOTAL_BUDGET_USD=1
CHANNEL3_MONTHLY_LIMIT=900

# Optional: a different Claude model. Defaults to claude-haiku-5-5.
# CLAUDE_MODEL=

# Optional, for hosting: keep the database in Backblaze B2 (or any S3-compatible storage)
# with Litestream, so restarts and deploys lose nothing. Leave empty to use the local file only.
# LITESTREAM_URL looks like: s3://your-bucket/allowance?endpoint=https://s3.us-east-005.backblazeb2.com
LITESTREAM_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Where the SQLite file lives. Defaults to data/allowance.db.
# DATABASE_PATH=
